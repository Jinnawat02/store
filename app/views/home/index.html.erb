<div class="space-y-8">
  <h1 class="text-3xl font-bold text-blue-700">Dashboard</h1>

  <!-- Summary Cards -->
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
    <!-- Products Card -->
    <div class="bg-white rounded-2xl shadow-md p-6 border-t-4 border-blue-500 flex flex-col h-72">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-lg font-semibold text-blue-700">Products</h2>
        <span class="text-4xl font-bold text-blue-600"><%= @products_count %></span>
      </div>
      <ul class="divide-y divide-blue-100 mb-4 overflow-y-auto flex-1">
        <% @recent_products.each do |product| %>
          <li class="py-1 text-sm text-gray-700">
            <%= link_to product.name, product_path(product), class: "hover:text-blue-600 transition" %>
          </li>
        <% end %>
        <% if @recent_products.empty? %>
          <li class="py-1 text-sm text-gray-400">No products yet.</li>
        <% end %>
      </ul>
      <%= link_to "View All Products →", products_path, class: "text-sm text-blue-600 hover:underline font-medium" %>
    </div>

    <!-- Categories Card -->
    <div class="bg-white rounded-2xl shadow-md p-6 border-t-4 border-indigo-500 flex flex-col h-72">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-lg font-semibold text-indigo-700">Categories</h2>
        <span class="text-4xl font-bold text-indigo-600"><%= @categories_count %></span>
      </div>
      <ul class="divide-y divide-indigo-100 mb-4 overflow-y-auto flex-1">
        <% @recent_categories.each do |category| %>
          <li class="py-1 text-sm text-gray-700">
            <%= link_to category.name, category_path(category), class: "hover:text-indigo-600 transition" %>
          </li>
        <% end %>
        <% if @recent_categories.empty? %>
          <li class="py-1 text-sm text-gray-400">No categories yet.</li>
        <% end %>
      </ul>
      <%= link_to "View All Categories →", categories_path, class: "text-sm text-indigo-600 hover:underline font-medium" %>
    </div>

    <!-- Shops Card -->
    <div class="bg-white rounded-2xl shadow-md p-6 border-t-4 border-sky-500 flex flex-col h-72">
      <div class="flex items-center justify-between mb-4">
        <h2 class="text-lg font-semibold text-sky-700">Shops</h2>
        <span class="text-4xl font-bold text-sky-600"><%= @shops_count %></span>
      </div>
      <ul class="divide-y divide-sky-100 mb-4 overflow-y-auto flex-1">
        <% @recent_shops.each do |shop| %>
          <li class="py-1 text-sm text-gray-700">
            <%= link_to shop.name, shop_path(shop), class: "hover:text-sky-600 transition" %>
          </li>
        <% end %>
        <% if @recent_shops.empty? %>
          <li class="py-1 text-sm text-gray-400">No shops yet.</li>
        <% end %>
      </ul>
      <%= link_to "View All Shops →", shops_path, class: "text-sm text-sky-600 hover:underline font-medium" %>
    </div>
  </div>

  <!-- Quick Actions -->
  <div class="bg-white rounded-2xl shadow-md p-6">
    <h2 class="text-lg font-semibold text-blue-700 mb-4">Quick Actions</h2>
    <div class="flex flex-wrap gap-3">
      <%= link_to "+ New Product", new_product_path, class: "bg-blue-600 hover:bg-blue-700 text-white font-semibold px-4 py-2 rounded-lg transition" %>
      <%= link_to "+ New Category", new_category_path, class: "bg-indigo-600 hover:bg-indigo-700 text-white font-semibold px-4 py-2 rounded-lg transition" %>
      <%= link_to "+ New Shop", new_shop_path, class: "bg-sky-600 hover:bg-sky-700 text-white font-semibold px-4 py-2 rounded-lg transition" %>
    </div>
  </div>
</div>
