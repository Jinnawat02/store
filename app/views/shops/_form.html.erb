<%= form_with model: shop, class: "space-y-5" do |form| %>
  <% if form.object.errors.any? %>
    <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded">
      <ul class="list-disc list-inside text-sm">
        <% form.object.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="flex flex-col gap-1">
    <%= form.label :name, "Shop Name", class: "text-sm font-semibold text-blue-700" %>
    <%= form.text_field :name, class: "w-full border border-blue-300 rounded-lg px-4 py-2 text-gray-800 focus:outline-none focus:ring-2 focus:ring-blue-500", placeholder: "Enter shop name" %>
  </div>

  <div class="flex items-center gap-3 pt-2">
    <%= form.submit "Save Shop", class: "bg-blue-600 hover:bg-blue-700 text-white font-semibold px-6 py-2 rounded-lg cursor-pointer transition" %>
    <%= link_to "Cancel", shops_path, class: "text-gray-500 hover:text-gray-700 font-medium transition" %>
  </div>
<% end %>