<div class="bg-white rounded-2xl shadow-md p-8">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-3xl font-bold text-blue-700">Shops</h1>
    <%= link_to "+ New Shop", new_shop_path, class: "bg-blue-600 hover:bg-blue-700 text-white font-semibold px-5 py-2 rounded-lg transition" %>
  </div>

  <% if @shops.any? %>
    <ul class="divide-y divide-blue-100">
      <% @shops.each do |shop| %>
        <li class="py-3 flex items-center justify-between">
          <span class="text-lg font-medium text-gray-800"><%= link_to shop.name, shop_path(shop), class: "hover:text-blue-600 transition" %></span>
          <div class="flex gap-3">
            <%= link_to "View", shop_path(shop), class: "text-sm text-blue-600 hover:underline" %>
            <%= link_to "Edit", edit_shop_path(shop), class: "text-sm text-yellow-600 hover:underline" %>
            <%= button_to "Delete", shop_path(shop), method: :delete, data: { turbo_confirm: "Are you sure?" }, class: "text-sm text-red-600 hover:underline bg-transparent border-none cursor-pointer" %>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-gray-400 text-center py-8">No shops yet. Add your first one!</p>
  <% end %>
</div>