<div class="bg-white rounded-2xl shadow-md p-8 max-w-2xl">
  <h1 class="text-3xl font-bold text-blue-700 mb-2"><%= @category.name %></h1>

  <section class="mt-6">
    <h2 class="text-xl font-semibold text-blue-500 mb-3">Products in this Category</h2>
    <% if @category.products.any? %>
      <ul class="divide-y divide-blue-100">
        <% @category.products.each do |product| %>
          <li class="py-2">
            <%= link_to product.name, product_path(product), class: "text-gray-800 hover:text-blue-600 font-medium transition" %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-gray-400">No products in this category yet.</p>
    <% end %>
  </section>

  <div class="flex flex-wrap gap-3 mt-8">
    <%= link_to "← Back", categories_path, class: "text-blue-600 hover:underline font-medium" %>
    <%= link_to "Edit", edit_category_path(@category), class: "bg-yellow-400 hover:bg-yellow-500 text-white font-semibold px-4 py-2 rounded-lg transition" %>
    <%= button_to "Delete", @category, method: :delete, data: { turbo_confirm: "Are you sure?" }, class: "bg-red-500 hover:bg-red-600 text-white font-semibold px-4 py-2 rounded-lg transition cursor-pointer" %>
  </div>
</div>