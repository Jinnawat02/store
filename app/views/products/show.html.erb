<div class="bg-white rounded-2xl shadow-md p-8 max-w-xl">
  <h1 class="text-3xl font-bold text-blue-700 mb-4"><%= @product.name %></h1>

  <dl class="mb-6 space-y-2 text-sm">
    <div class="flex gap-2">
      <dt class="font-semibold text-blue-600 w-24">Category</dt>
      <dd class="text-gray-700">
        <% if @product.category %>
          <%= link_to @product.category.name, category_path(@product.category), class: "hover:text-blue-600 underline" %>
        <% else %>
          <span class="text-gray-400">—</span>
        <% end %>
      </dd>
    </div>
    <div class="flex gap-2">
      <dt class="font-semibold text-blue-600 w-24">Shops</dt>
      <dd class="text-gray-700">
        <% if @product.shops.any? %>
          <%= @product.shops.map { |s| link_to(s.name, shop_path(s), class: "hover:text-blue-600 underline") }.join(", ").html_safe %>
        <% else %>
          <span class="text-gray-400">—</span>
        <% end %>
      </dd>
    </div>
  </dl>

  <div class="flex flex-wrap gap-3 mt-4">
    <%= link_to "← Back", products_path, class: "text-blue-600 hover:underline font-medium" %>
    <%= link_to "Edit", edit_product_path(@product), class: "bg-yellow-400 hover:bg-yellow-500 text-white font-semibold px-4 py-2 rounded-lg transition" %>
    <%= button_to "Delete", @product, method: :delete, data: { turbo_confirm: "Are you sure?" }, class: "bg-red-500 hover:bg-red-600 text-white font-semibold px-4 py-2 rounded-lg transition cursor-pointer" %>
  </div>
</div>
